# ===========================================================================
# The Lenny Growth Assistant -- environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
# Every value below is a safe placeholder and the defaults work offline,
# with no API key and no cloud account, using Ollama only.
#
# Legend:  [REQUIRED] must be set   [OPTIONAL] has a working default
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local                                   # [OPTIONAL] local | ci | production
LOG_LEVEL=INFO                                      # [OPTIONAL] DEBUG | INFO | WARNING | ERROR
API_PORT=8000                                       # [OPTIONAL]
CORS_ORIGINS=http://localhost:5173,http://localhost:8080  # [OPTIONAL]
REQUEST_TIMEOUT_SECONDS=180                         # [OPTIONAL] per-turn ceiling; CPU inference is slow
INTERNAL_TOOL_TOKEN=change-me-local-only            # [REQUIRED] shared secret for the Pi extension -> FastAPI tool callbacks
INTERNAL_TOOL_BASE_URL=http://localhost:8000        # [OPTIONAL] where the extension reaches the API (localhost inside the api container)

# ---------------------------------------------------------------------------
# PostgreSQL (+ pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=lenny                                 # [OPTIONAL]
POSTGRES_PASSWORD=lenny_local_password              # [OPTIONAL] local-only default; override anywhere real
POSTGRES_DB=lenny_growth_assistant                  # [OPTIONAL]
POSTGRES_HOST=db                                    # [OPTIONAL] 'db' inside Compose, 'localhost' if running natively
POSTGRES_PORT=5432                                  # [OPTIONAL]

# ---------------------------------------------------------------------------
# Model selection  <-- the provider toggle the brief asks for
# ---------------------------------------------------------------------------
# Switch models WITHOUT changing application code or restarting the stack.
# The active provider is surfaced in the UI on every session.
LLM_PROVIDER=ollama                                 # [OPTIONAL] ollama | anthropic
PROVIDER_FALLBACK_CHAIN=ollama                       # [OPTIONAL] comma-separated order tried when the selected provider is unreachable

# --- Local model (Ollama) -- MANDATORY for the demo, works offline --------
OLLAMA_BASE_URL=http://ollama:11434                  # [OPTIONAL] the in-Compose Ollama service (self-contained default)
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # [OPTIONAL] use a native Ollama already running on the host instead
#                                                    #            (then start only what you need: docker compose up -d db)
OLLAMA_MODEL=llama3.2:3b                             # [OPTIONAL] conservative CPU default; see README upgrade ladder
OLLAMA_EMBED_MODEL=nomic-embed-text                  # [OPTIONAL] 768-dim, ~274MB, CPU-friendly
OLLAMA_KEEP_ALIVE=30m                                # [OPTIONAL] keep the model resident between turns

# --- Cloud model (Anthropic Claude) -- OPTIONAL ---------------------------
# Leave blank to run fully offline. When blank, 'anthropic' shows in the UI
# as disabled *with the reason*, rather than being hidden.
ANTHROPIC_API_KEY=                                   # [OPTIONAL] sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5                    # [OPTIONAL]

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMBEDDING_DIM=768                                    # [OPTIONAL] must match OLLAMA_EMBED_MODEL
EMBED_BATCH_SIZE=32                                  # [OPTIONAL]

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
TRANSCRIPT_SOURCE=repo                               # [OPTIONAL] repo | local
TRANSCRIPT_REPO=ChatPRD/lennys-podcast-transcripts   # [OPTIONAL] upstream corpus
TRANSCRIPT_LOCAL_PATH=                               # [OPTIONAL] set when TRANSCRIPT_SOURCE=local
TRANSCRIPT_CACHE_DIR=/data/transcripts                # [OPTIONAL] cached corpus location (volume)
CHUNK_TARGET_TOKENS=500                              # [OPTIONAL] speaker-aware merge target
CHUNK_OVERLAP_RATIO=0.15                             # [OPTIONAL]

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RAG_TOP_K=6                                          # [OPTIONAL] chunks handed to the model
RAG_VECTOR_CANDIDATES=50                             # [OPTIONAL] pgvector HNSW shortlist
RAG_LEXICAL_CANDIDATES=50                            # [OPTIONAL] Postgres FTS shortlist
RAG_RRF_K=60                                         # [OPTIONAL] reciprocal rank fusion constant
RAG_MIN_SCORE=0.65                                   # [OPTIONAL] relevance floor, measured via `make calibrate` -- see docs/decisions.md (ADR-003)

# ---------------------------------------------------------------------------
# Agent (Pi Coding Agent, driven over RPC)
# ---------------------------------------------------------------------------
# Pi finds this catalog at $PI_CODING_AGENT_DIR/models.json. The ./agent mount is
# read-only, so the app copies it to a writable home at runtime (Pi writes its
# credential store and session dir into its config directory).
PI_BIN=pi                                            # [OPTIONAL] path to the pi executable
PI_EXTENSION_PATH=/app/agent/growth-extension.ts     # [OPTIONAL] our three-tool surface
PI_CONFIG_SOURCE=/app/agent                          # [OPTIONAL] read-only catalog + extension
PI_AGENT_HOME=/tmp/pi-agent                          # [OPTIONAL] writable Pi config home
PI_MAX_SESSIONS=4                                    # [OPTIONAL] LRU cap on live Pi processes
PI_IDLE_TIMEOUT_SECONDS=900                          # [OPTIONAL] evict idle Pi processes
PI_MAX_TURNS=8                                       # [OPTIONAL]

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api                               # [OPTIONAL] nginx proxies /api in the container build
